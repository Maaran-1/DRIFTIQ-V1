# DRIFTIQ MVP configuration — copy this file to `.env` and edit.
# You only need to fill in keys for the providers you actually use.

# ============ ASR (speech-to-text) ============
# Options: local | groq | openai
ASR_PROVIDER=local
WHISPER_MODEL=base          # tiny | base | small | medium | large
GROQ_API_KEY=
OPENAI_API_KEY=

# ============ LLM (extraction) ============
# Options: ollama | gemini | openai | claude
LLM_PROVIDER=ollama

# Ollama (local, free)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Google Gemini (free tier)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# OpenAI
OPENAI_LLM_MODEL=gpt-4o-mini

# Anthropic Claude
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_API_KEY=

# ============ Database ============
# Postgres connection string (Neon / Supabase / Railway).
# Leave empty to fall back to a local SQLite file (./driftiq.db) for dev.
DATABASE_URL=

# ============ Auth ============
# JWT signing secret — REQUIRED in production, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_MINUTES=10080

# ============ Server ============
PORT=8000
UPLOAD_DIR=/tmp/driftiq_uploads
MAX_UPLOAD_MB=200          # reject larger uploads with a 413
ASR_CHUNK_MB=20            # split transcoded audio above this for API ASR
